<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yaroslav's Games</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: sans-serif; }
        body { background-color: #0f172a; color: #f8fafc; display: flex; min-height: 100vh; }
        sidebar { width: 280px; background-color: #1e293b; padding: 20px; display: flex; flex-direction: column; gap: 15px; border-right: 1px solid #334155; }
        sidebar h1 { font-size: 1.4rem; color: #38bdf8; text-align: center; }
        .game-btn { background-color: #334155; color: #fff; border: none; padding: 12px 16px; border-radius: 8px; cursor: pointer; text-align: left; transition: 0.2s; }
        .game-btn:hover, .game-btn.active { background-color: #0284c7; }
        main { flex: 1; display: flex; align-items: center; justify-content: center; padding: 20px; }
        #game-container { width: 100%; max-width: 960px; height: 600px; background-color: #000; border-radius: 12px; overflow: hidden; }
        iframe { width: 100%; height: 100%; border: none; }
    </style>
</head>
<body>
    <sidebar>
        <h1>🎮 Игровой Портал</h1>
        <button class="game-btn active" onclick="loadGame('games/game1/index.html', this)">Игра 1</button>
    </sidebar>
    <main>
        <div id="game-container">
            <iframe id="game-frame" src="games/game1/index.html"></iframe>
        </div>
    </main>
    <script>
        function loadGame(url, button) {
            document.getElementById('game-frame').src = url;
            document.querySelectorAll('.game-btn').forEach(btn => btn.classList.remove('active'));
            if(button) button.classList.add('active');
        }
    </script>
</body>
</html>
